NODE_ENV=development
LOG_LEVEL=info
TRADING_MODE=paper
ENABLED_PRODUCTS=BTC-USD,ETH-USD
BASE_CURRENCY=USD
MAX_TRADE_NOTIONAL_USD=25
MAX_PRODUCT_EXPOSURE_PCT=10
MAX_TOTAL_EXPOSURE_PCT=20
MAX_DAILY_LOSS_PCT=1
MIN_SECONDS_BETWEEN_TRADES=1800
ALLOW_SHORTS=false
ALLOW_LEVERAGE=false
REQUIRE_ORDER_PREVIEW=true
LIVE_TRADING_ACK=false
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=
COINBASE_REST_BASE_URL=https://api.coinbase.com/api/v3/brokerage
COINBASE_SANDBOX_REST_BASE_URL=https://api-sandbox.coinbase.com/api/v3/brokerage
USE_SAMPLE_MARKET_DATA=false
PERSISTENCE_ENABLED=true
DATABASE_URL=postgresql://crypto_agent:crypto_agent@localhost:5432/crypto_agent
PORT=3000

# --- API security (required in production; must each be >= 32 chars and differ) ---
# Operator bearer token: dashboard server -> API. Worker -> API uses the
# distinct internal token via the x-internal-token header.
OPERATOR_API_TOKEN=
INTERNAL_API_TOKEN=
# Comma-separated browser origins allowed by CORS (e.g. http://localhost:4000).
ALLOWED_ORIGINS=
# Set true only behind a trusted reverse proxy/TLS terminator.
TRUST_PROXY=false
API_BODY_LIMIT_BYTES=65536
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000

# --- Dashboard server-side proxy (apps/dashboard) ---
# Base URL the dashboard server uses to reach the API. The dashboard reads
# OPERATOR_API_TOKEN from its own server env and never exposes it to the browser.
AGENT_API_URL=http://localhost:3000

# --- Operational alerts (apps/api) ---
# Optional authenticated webhook for kill switch / drift / halt alerts. Required
# by the live-trading preflight (pnpm live:preflight).
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=

# --- Live preflight / recovery ---
# RECONCILIATION_OK must be set true by an out-of-band read-only reconciliation
# before going live; the preflight does not fabricate it.
RECONCILIATION_OK=false
# Optional: encrypt backups to this age recipient (pnpm backup).
BACKUP_AGE_RECIPIENT=

# --- Worker heartbeat (apps/worker) ---
# The worker posts portfolio + liveness to AGENT_API_URL/internal/heartbeat,
# authenticated with INTERNAL_API_TOKEN. WORKER_ID identifies this worker in the
# durable heartbeat/audit tables (defaults to "worker-1").
WORKER_ID=worker-1
