# ============================================================================
# Autonomous Crypto Trading Agent — Environment Reference
# ============================================================================
# Copy to .env and fill in values. See TECH_SPEC.md §3 for full validation rules.
# Defaults shown are the safe paper-trading defaults from PRD §"Suggested v1 default configuration".

# ----------------------------------------------------------------------------
# Mode and product allowlist
# ----------------------------------------------------------------------------
TRADING_MODE=paper                       # paper | sandbox | live
ENABLED_PRODUCTS=BTC-USD,ETH-USD
BASE_CURRENCY=USD

# ----------------------------------------------------------------------------
# Risk policy hard limits (see RISK_POLICY.md)
# ----------------------------------------------------------------------------
MAX_TRADE_NOTIONAL_USD=25                # Hard ceiling per single order
MAX_PRODUCT_EXPOSURE_PCT=10              # Max % of portfolio in any one product
MAX_TOTAL_EXPOSURE_PCT=20                # Max % of portfolio across all crypto
MAX_DAILY_LOSS_PCT=1                     # Stop opening new positions after this drawdown
MIN_SECONDS_BETWEEN_TRADES=1800          # Per-product cooldown
ALLOW_SHORTS=false
ALLOW_LEVERAGE=false
REQUIRE_ORDER_PREVIEW=true               # Call Coinbase preview before every live order

# ----------------------------------------------------------------------------
# Live trading gate (DO NOT enable until LIVE_TRADING_CHECKLIST.md passes)
# ----------------------------------------------------------------------------
LIVE_TRADING_ACK=false                   # Must be true to start in TRADING_MODE=live

# ----------------------------------------------------------------------------
# Infrastructure
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://act:act@localhost:5432/act
REDIS_URL=redis://localhost:6379
PERSISTENCE_ENABLED=true                 # Set false for offline smoke tests
USE_SAMPLE_MARKET_DATA=false             # Set true if Coinbase public is unavailable

# ----------------------------------------------------------------------------
# Coinbase Advanced Trade credentials
# Required for sandbox + live modes. Leave empty for paper mode.
# Generate via Coinbase Developer Platform with VIEW + TRADE scopes for live,
# VIEW-only for read services where possible.
# ----------------------------------------------------------------------------
COINBASE_API_KEY_NAME=
COINBASE_PRIVATE_KEY=

# ----------------------------------------------------------------------------
# LLM provider (Anthropic Claude default)
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL_ID=claude-sonnet-4-6
LLM_TIMEOUT_MS=15000

# ----------------------------------------------------------------------------
# Operator API
# ----------------------------------------------------------------------------
OPERATOR_API_TOKEN=                      # Bearer token for ops endpoints. Rotate manually.
OPERATOR_API_PORT=3000

# ----------------------------------------------------------------------------
# Observability
# ----------------------------------------------------------------------------
LOG_LEVEL=info                           # debug | info | warn | error
METRICS_PORT=9090
ALERT_WEBHOOK_URL=                       # Optional: webhook for live order + kill switch alerts

# ----------------------------------------------------------------------------
# Loop tuning
# ----------------------------------------------------------------------------
LOOP_INTERVAL_SECONDS=60                 # How often the trading loop ticks
RECONCILIATION_INTERVAL_SECONDS=30
STALE_DATA_THRESHOLD_SECONDS=120         # Skip product if market data older than this
RECONCILIATION_DRIFT_THRESHOLD=3         # Drift events within window → circuit breaker
